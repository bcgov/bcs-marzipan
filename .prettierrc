{
  "semi": true,
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "endOfLine": "auto",
  "trailingComma": "es5",
  "arrowParens": "always",
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrderTypeScriptVersion": "5.0.0",
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "importOrder": [
    "<<BUILTIN_MODULES>>",
    "",
    "<<THIRD_PARTY_MODULES>>",
    "",
    "^@corpcal/(.*)$",
    "",
    "^[.]"
  ],
  "overrides": [
    {
      "files": "calendar-ui/**/*.{ts,tsx}",
      "options": {
        "importOrder": [
          "^react$",
          "",
          "<<THIRD_PARTY_MODULES>>",
          "",
          "^@corpcal/(.*)$",
          "^@/(.*)$",
          "",
          "^[.]"
        ]
      }
    }
  ]
}
