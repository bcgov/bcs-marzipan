# Pre-push validation hook
# 1. Repo-wide formatting (format:check)
# 2. Lint and typecheck across workspaces (check)
# 3. Shared package schema / DB type alignment (validate-types)
# 4. Branch name pattern for feature branches
#
# Full build, tests, and k6 validation run in CI via npm run verify on pull requests.

echo "Running pre-push quality gate..."

npm run format:check --silent || {
  echo ""
  echo "Formatting check failed! Run: npm run format"
  echo ""
  exit 1
}

npm run check --silent || {
  echo ""
  echo "Lint or typecheck failed! Run: npm run check"
  echo ""
  exit 1
}

echo "Running type validation..."

npm run validate-types --workspace=packages/shared --silent 2>/dev/null
validation_result=$?

if [ $validation_result -ne 0 ]; then
  echo ""
  echo "Type validation failed!"
  echo ""
  echo "Schema types are out of sync. Please fix the following:"
  echo "  1. Run: npm run validate-types --workspace=packages/shared"
  echo "  2. Review the output for type mismatches"
  echo "  3. Update schemas or types as needed"
  echo ""
  echo "See packages/database/src/schema/docs/SCHEMA_README.md for guidance."
  echo ""
  exit 1
fi

echo "Pre-push quality gate passed."
echo ""

branch_name=$(git rev-parse --abbrev-ref HEAD)

if [ "$branch_name" = "main" ] || [ "$branch_name" = "master" ] || [ "$branch_name" = "develop" ]; then
  exit 0
fi

pattern="^(feat|fix|docs|style|refactor|test|build|chore)/CORPCAL-[0-9]+-[a-z0-9-]+$"

if ! echo "$branch_name" | grep -qE "$pattern"; then
  echo ""
  echo "Invalid branch name: $branch_name"
  echo ""
  echo "Branch names must follow the format: <type>/CORPCAL-<number>-<short-description>"
  echo ""
  echo "Valid types: feat, fix, docs, style, refactor, test, build, chore"
  echo "Jira key format: CORPCAL-<number> (must be uppercase, e.g., CORPCAL-123)"
  echo "Description: all lowercase, hyphens allowed, no spaces"
  echo ""
  echo "Example:"
  echo "  feat/CORPCAL-123-add-user-authentication"
  echo ""
  exit 1
fi

echo "Branch name is valid: $branch_name"
