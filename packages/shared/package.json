  "scripts": {
    "build": "npm run build:tokens && npm run build:esm && npm run build:cjs",
    "build:embed-logo": "node scripts/embed-bc-logo-print-data-url.mjs",
    "build:tokens": "node scripts/build-corpcal-tokens.mjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "validate-types": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@corpcal/database": "*",
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/html": "^3.22.3",
    "@tiptap/markdown": "^3.22.3",
    "happy-dom": "^20.8.9",
    "@tiptap/starter-kit": "^3.22.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.555.0",
    "sanitize-html": "^2.17.4",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
