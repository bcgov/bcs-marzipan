exports[`renderPrintReportFragmentHtml > renders exec look-ahead print with title and summary in the activity details column 1`] = `"<div class="corpcal-print-root" data-report-template="EXEC_LOOK_AHEAD"><header class="corpcal-print-header"><span class="corpcal-print-header-confidential">DRAFT AND CONFIDENTIAL</span><h1 class="corpcal-print-header-title">Look Ahead</h1><p class="corpcal-print-header-range">Sun, Apr 26, 2026 to Sun, Apr 26, 2026</p></header><div class="corpcal-print-banner">DRAFT ONLY — NOT FOR CIRCULATION<span class="corpcal-print-banner-sub">Information is confidential and subject to change.</span></div><div class="corpcal-print-body"><section class="corpcal-print-section-block"><div class="corpcal-print-section-heading"><span>Events</span></div><div class="corpcal-print-day"><h3 class="corpcal-print-day-heading">SUNDAY, APRIL 26, 2026</h3><div class="corpcal-print-table-wrap"><table class="corpcal-print-table" role="grid"><colgroup><col class="corpcal-print-col-1"/><col class="corpcal-print-col-2"/><col class="corpcal-print-col-3"/><col class="corpcal-print-col-4"/><col class="corpcal-print-col-5"/></colgroup><thead><tr><th scope="col" class="corpcal-print-col-1">Date &amp; Time</th><th scope="col" class="corpcal-print-col-2">Lead</th><th scope="col" class="corpcal-print-col-3">Activity Details</th><th scope="col" class="corpcal-print-col-4">Release</th><th scope="col" class="corpcal-print-col-5">Activity</th></tr></thead><tbody><tr><td class="corpcal-print-col-1"><div class="corpcal-print-stack"><div class="corpcal-print-inline-row"><span class="corpcal-print-meta-strong">Apr 26, 2026</span><span class="corpcal-print-inline-status"> · confirmed</span></div><div class="corpcal-print-inline-row"><span class="corpcal-print-meta-strong">10:00 am</span><span class="corpcal-print-inline-status"> · confirmed</span></div><div><span class="corpcal-print-pill corpcal-print-pill-la-new">New</span></div></div></td><td class="corpcal-print-col-2"><div class="corpcal-print-stack"><div class="corpcal-print-meta-strong">HOUS</div><div class="corpcal-print-meta">Ministry of Housing</div></div></td><td class="corpcal-print-col-3"><div class="corpcal-print-stack-md"><div class="corpcal-print-flags"><span class="corpcal-print-flag corpcal-print-flag-alert">ISSUE</span></div><div class="corpcal-print-title">Minister announces housing investment</div><div class="corpcal-print-rich"><p>The Minister will announce new housing funding and respond to media questions. See <a target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2" href="https://news.gov.bc.ca/backgrounders/b-101">https://news.gov.bc.ca/backgrounders/b-101</a> for background.</p></div><div class="corpcal-print-meta-strong">Victoria, Legislative Assembly, 501 Belleville St, BC</div><div class="corpcal-print-meta-faint">Event planner: Alex Planner</div></div></td><td class="corpcal-print-col-4"><div class="corpcal-print-stack"><div class="corpcal-print-meta-strong">Issued</div><div class="corpcal-print-inline-row"><span class="corpcal-print-meta">Translations: French, Punjabi</span></div></div></td><td class="corpcal-print-col-5"><div class="corpcal-print-stack"><div class="corpcal-print-meta"><a class="corpcal-print-link" href="https://corpcal.example.gov.bc.ca/activity/101" target="_blank" rel="noopener noreferrer">ACT-101</a></div><div class="corpcal-print-meta-faint">Updated Apr 26, 2026 10:05 am</div></div></td></tr></tbody></table></div></div></section></div><footer class="corpcal-print-page-footer"><div class="corpcal-print-page-footer-line corpcal-print-page-footer-confidential">DRAFT AND CONFIDENTIAL</div><div class="corpcal-print-page-footer-line corpcal-print-page-footer-timestamp">Monday Apr 27, 8:30 am</div><div class="corpcal-print-page-footer-line corpcal-print-page-footer-hint">CHANGED indicates major detail or date changes only (not time switches).</div></footer></div>"`;

exports[`renderPrintReportFragmentHtml > renders look-ahead print with executive summary in the activity details column 1`] = `"<div class="corpcal-print-root" data-report-template="LOOK_AHEAD"><header class="corpcal-print-header"><span class="corpcal-print-header-confidential">DRAFT AND CONFIDENTIAL</span><h1 class="corpcal-print-header-title">Look Ahead</h1><p class="corpcal-print-header-range">Sun, Apr 26, 2026 to Sun, Apr 26, 2026</p></header><div class="corpcal-print-banner">DRAFT ONLY — NOT FOR CIRCULATION<span class="corpcal-print-banner-sub">Information is confidential and subject to change.</span></div><div class="corpcal-print-body"><section class="corpcal-print-section-block"><div class="corpcal-print-section-heading"><span>Events</span></div><div class="corpcal-print-day"><h3 class="corpcal-print-day-heading">SUNDAY, APRIL 26, 2026</h3><div class="corpcal-print-table-wrap"><table class="corpcal-print-table" role="grid"><colgroup><col class="corpcal-print-col-1"/><col class="corpcal-print-col-2"/><col class="corpcal-print-col-3"/><col class="corpcal-print-col-4"/><col class="corpcal-print-col-5"/></colgroup><thead><tr><th scope="col" class="corpcal-print-col-1">Date &amp; Time</th><th scope="col" class="corpcal-print-col-2">Lead</th><th scope="col" class="corpcal-print-col-3">Activity Details</th><th scope="col" class="corpcal-print-col-4">Release</th><th scope="col" class="corpcal-print-col-5">Activity</th></tr></thead><tbody><tr><td class="corpcal-print-col-1"><div class="corpcal-print-stack"><div class="corpcal-print-inline-row"><span class="corpcal-print-meta-strong">Apr 26, 2026</span><span class="corpcal-print-inline-status"> · confirmed</span></div><div class="corpcal-print-inline-row"><span class="corpcal-print-meta-strong">10:00 am</span><span class="corpcal-print-inline-status"> · confirmed</span></div><div><span class="corpcal-print-pill corpcal-print-pill-la-new">New</span></div></div></td><td class="corpcal-print-col-2"><div class="corpcal-print-stack"><div class="corpcal-print-meta-strong">HOUS</div><div class="corpcal-print-meta">Ministry of Housing</div></div></td><td class="corpcal-print-col-3"><div class="corpcal-print-stack-md"><div class="corpcal-print-flags"><span class="corpcal-print-flag corpcal-print-flag-alert">ISSUE</span></div><div class="corpcal-print-exec-summary-inline"><span class="corpcal-print-meta-faint">Victoria: </span><div class="corpcal-print-rich corpcal-print-rich-inline"><p>Investment of $500M over three years to accelerate affordable housing near transit.</p></div></div><div class="corpcal-print-meta-strong">Victoria, Legislative Assembly, 501 Belleville St, BC</div><div class="corpcal-print-meta-faint">Event planner: Alex Planner</div></div></td><td class="corpcal-print-col-4"><div class="corpcal-print-stack"><div class="corpcal-print-meta-strong">Issued</div><div class="corpcal-print-inline-row"><span class="corpcal-print-meta">Translations: French, Punjabi</span></div></div></td><td class="corpcal-print-col-5"><div class="corpcal-print-stack"><div class="corpcal-print-meta"><a class="corpcal-print-link" href="https://corpcal.example.gov.bc.ca/activity/101" target="_blank" rel="noopener noreferrer">ACT-101</a></div><div class="corpcal-print-meta-faint">Updated Apr 26, 2026 10:05 am</div></div></td></tr></tbody></table></div></div></section></div><footer class="corpcal-print-page-footer"><div class="corpcal-print-page-footer-line corpcal-print-page-footer-confidential">DRAFT AND CONFIDENTIAL</div><div class="corpcal-print-page-footer-line corpcal-print-page-footer-timestamp">Monday Apr 27, 8:30 am</div><div class="corpcal-print-page-footer-line corpcal-print-page-footer-hint">CHANGED indicates major detail or date changes only (not time switches).</div></footer></div>"`;

exports[`renderPrintReportFragmentHtml > renders the custom report as a React fragment 1`] = `"<div class="custom-report-root"><h1 class="custom-report-doc-title">Custom</h1><div class="custom-report-table-wrap"><table class="custom-report-table" role="table"><thead><tr class="custom-report-thead-row"><th scope="col" class="custom-report-th custom-report-col-date">Date &amp; Time</th><th scope="col" class="custom-report-th custom-report-col-lead">Lead</th><th scope="col" class="custom-report-th custom-report-col-details">Activity Details</th><th scope="col" class="custom-report-th custom-report-col-release">Release</th><th scope="col" class="custom-report-th custom-report-col-id">Activity ID</th></tr></thead><tbody><tr class="custom-report-section-row"><td colSpan="5">Events (1)</td></tr><tr class="custom-report-tr custom-report-row-odd"><td class="custom-report-td"><div class="custom-report-stack custom-report-stack-md"><div><div class="custom-report-text-sm-medium"><span class="custom-report-dt-value">Apr 26, 2026</span><span class="custom-report-dt-inline-muted"> · confirmed</span></div><div class="custom-report-text-sm-medium custom-report-dt-time-row"><span class="custom-report-dt-value">10:00 am</span><span class="custom-report-dt-inline-muted"> · confirmed</span></div></div></div></td><td class="custom-report-td"><div class="custom-report-stack custom-report-stack-sm"><div><div class="custom-report-text-xs-medium-muted">Ministry</div><div class="custom-report-text-sm-medium">HOUS</div></div><div><div class="custom-report-text-xs-medium-muted">Organization</div><div class="custom-report-text-sm-muted">Ministry of Housing</div></div></div></td><td class="custom-report-td custom-report-td-break"><div class="custom-report-stack custom-report-stack-lg"><div><div class="custom-report-title">Minister announces housing investment</div></div><div class="custom-report-text-xs-medium-alert">Issue</div><div class="custom-report-text-xs-medium-muted custom-report-rich-wrap"><div class="custom-report-rich-text"><p>The Minister will announce new housing funding and respond to media questions. See <a target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2" href="https://news.gov.bc.ca/backgrounders/b-101">https://news.gov.bc.ca/backgrounders/b-101</a> for background.</p></div></div><div class="custom-report-exec-summary custom-report-rich-wrap"><div class="custom-report-rich-text"><p>Investment of $500M over three years to accelerate affordable housing near transit.</p></div></div><div class="custom-report-text-xs-medium-muted custom-report-rich-wrap"></div><div class="custom-report-text-xs-medium-muted">Event planner: Alex Planner</div></div></td><td class="custom-report-td"><div class="custom-report-stack custom-report-stack-md"><div class="custom-report-text-xs-medium-muted">Issued</div><div class="custom-report-text-xs-medium-muted">French, Punjabi</div><div><div class="custom-report-text-xs-medium-muted">LA Status</div><div class="custom-report-la-badge-wrap"><span class="custom-report-badge custom-report-badge-info">New</span></div></div></div></td><td class="custom-report-td"><div class="custom-report-stack custom-report-stack-md"><div class="custom-report-display-id">ACT-101</div><div><div class="custom-report-text-xs-medium-muted">Status</div><div class="custom-report-status-badge-wrap"><span class="custom-report-badge custom-report-badge-secondary">active</span></div></div></div></td></tr><tr class="custom-report-section-row"><td colSpan="5">Empty (0)</td></tr></tbody></table></div><footer class="corpcal-print-page-footer"><div class="corpcal-print-page-footer-line corpcal-print-page-footer-confidential">DRAFT AND CONFIDENTIAL</div><div class="corpcal-print-page-footer-line corpcal-print-page-footer-timestamp">Monday Apr 27, 8:30 am</div><div class="corpcal-print-page-footer-line corpcal-print-page-footer-hint">CHANGED indicates major detail or date changes only (not time switches).</div></footer></div>"`;

