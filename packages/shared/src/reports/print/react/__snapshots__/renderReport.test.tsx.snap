// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderPrintReportFragmentHtml > renders a stable fragment for a look-ahead report 1`] = `"<div class="corpcal-print-root" data-report-template="LOOK_AHEAD"><header class="corpcal-print-header"><span class="corpcal-print-header-confidential">DRAFT AND CONFIDENTIAL</span><h1 class="corpcal-print-header-title">Look Ahead</h1><p class="corpcal-print-header-range">Sun, Apr 26, 2026 to Sun, Apr 26, 2026</p></header><div class="corpcal-print-banner">DRAFT ONLY — NOT FOR CIRCULATION<span class="corpcal-print-banner-sub">Information is confidential and subject to change.</span></div><div class="corpcal-print-contents"><div class="corpcal-print-contents-title">Contents:</div><ul><li>Events</li></ul></div><div class="corpcal-print-body"><section class="corpcal-print-day"><h2 class="corpcal-print-day-heading">SUNDAY, APRIL 26, 2026</h2><div><div class="corpcal-print-section-heading">Events</div><div class="corpcal-print-table-wrap"><table class="corpcal-print-table" role="grid"><thead><tr><th scope="col" class="corpcal-print-col-1">Date &amp; Time</th><th scope="col" class="corpcal-print-col-2">Lead</th><th scope="col" class="corpcal-print-col-3">Activity Details</th><th scope="col" class="corpcal-print-col-4">Release</th></tr></thead><tbody><tr><td class="corpcal-print-col-1"><div class="corpcal-print-stack"><div class="corpcal-print-meta-strong">Apr 26, 2026</div><div class="corpcal-print-meta">confirmed</div><div class="corpcal-print-meta-strong">10:00 am</div><div class="corpcal-print-meta">confirmed</div><div><span class="corpcal-print-pill corpcal-print-pill-la-new">New</span></div></div></td><td class="corpcal-print-col-2"><div class="corpcal-print-stack"><div class="corpcal-print-meta-strong">HOUS</div><div class="corpcal-print-meta">Ministry of Housing</div><div class="corpcal-print-meta"><a class="corpcal-print-link" href="https://corpcal.example.gov.bc.ca/activity/101" target="_blank" rel="noopener noreferrer">ACT-101</a></div><div class="corpcal-print-meta-faint">Updated Apr 26, 2026 10:05 am</div></div></td><td class="corpcal-print-col-3"><div class="corpcal-print-stack-md"><div class="corpcal-print-flags"><span class="corpcal-print-pill corpcal-print-pill-issue">Issue</span></div><div class="corpcal-print-meta-faint">Victoria</div><div class="corpcal-print-title">Minister announces housing investment</div><div class="corpcal-print-rich"><p>The Minister will announce new housing funding and respond to media questions. See <a target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2" href="https://news.gov.bc.ca/backgrounders/b-101">https://news.gov.bc.ca/backgrounders/b-101</a> for background.</p></div><div class="corpcal-print-meta">Victoria, Legislative Assembly, 501 Belleville St, BC</div><div class="corpcal-print-meta-faint">Event planner: Alex Planner</div></div></td><td class="corpcal-print-col-4"><div class="corpcal-print-stack"><div class="corpcal-print-meta-strong">Issued</div><div class="corpcal-print-meta">French, Punjabi</div></div></td></tr></tbody></table></div></div></section></div><footer class="corpcal-print-footer"><div class="corpcal-print-footer-confidential">DRAFT AND CONFIDENTIAL</div><div>Report generated Monday, Apr 27, 2026, 8:30 AM. “Changed” applies to major detail or date changes only (not time switches).</div></footer></div>"`;

exports[`renderPrintReportFragmentHtml > renders the exec variant with executive summary instead of title/summary 1`] = `"<div class="corpcal-print-root" data-report-template="EXEC_LOOK_AHEAD"><header class="corpcal-print-header"><span class="corpcal-print-header-confidential">DRAFT AND CONFIDENTIAL</span><h1 class="corpcal-print-header-title">Look Ahead</h1><p class="corpcal-print-header-range">Sun, Apr 26, 2026 to Sun, Apr 26, 2026</p></header><div class="corpcal-print-banner">DRAFT ONLY — NOT FOR CIRCULATION<span class="corpcal-print-banner-sub">Information is confidential and subject to change.</span></div><div class="corpcal-print-contents"><div class="corpcal-print-contents-title">Contents:</div><ul><li>Events</li></ul></div><div class="corpcal-print-body"><section class="corpcal-print-day"><h2 class="corpcal-print-day-heading">SUNDAY, APRIL 26, 2026</h2><div><div class="corpcal-print-section-heading">Events</div><div class="corpcal-print-table-wrap"><table class="corpcal-print-table" role="grid"><thead><tr><th scope="col" class="corpcal-print-col-1">Date &amp; Time</th><th scope="col" class="corpcal-print-col-2">Lead</th><th scope="col" class="corpcal-print-col-3">Activity Details</th><th scope="col" class="corpcal-print-col-4">Release</th></tr></thead><tbody><tr><td class="corpcal-print-col-1"><div class="corpcal-print-stack"><div class="corpcal-print-meta-strong">Apr 26, 2026</div><div class="corpcal-print-meta">confirmed</div><div class="corpcal-print-meta-strong">10:00 am</div><div class="corpcal-print-meta">confirmed</div><div><span class="corpcal-print-pill corpcal-print-pill-la-new">New</span></div></div></td><td class="corpcal-print-col-2"><div class="corpcal-print-stack"><div class="corpcal-print-meta-strong">HOUS</div><div class="corpcal-print-meta">Ministry of Housing</div><div class="corpcal-print-meta"><a class="corpcal-print-link" href="https://corpcal.example.gov.bc.ca/activity/101" target="_blank" rel="noopener noreferrer">ACT-101</a></div><div class="corpcal-print-meta-faint">Updated Apr 26, 2026 10:05 am</div></div></td><td class="corpcal-print-col-3"><div class="corpcal-print-stack-md"><div class="corpcal-print-flags"><span class="corpcal-print-pill corpcal-print-pill-issue">Issue</span></div><div class="corpcal-print-meta-faint">Victoria</div><div class="corpcal-print-rich"><p>Investment of $500M over three years to accelerate affordable housing near transit.</p></div><div class="corpcal-print-meta">Victoria, Legislative Assembly, 501 Belleville St, BC</div><div class="corpcal-print-meta-faint">Event planner: Alex Planner</div></div></td><td class="corpcal-print-col-4"><div class="corpcal-print-stack"><div class="corpcal-print-meta-strong">Issued</div><div class="corpcal-print-meta">French, Punjabi</div></div></td></tr></tbody></table></div></div></section></div><footer class="corpcal-print-footer"><div class="corpcal-print-footer-confidential">DRAFT AND CONFIDENTIAL</div><div>Report generated Monday, Apr 27, 2026, 8:30 AM. “Changed” applies to major detail or date changes only (not time switches).</div></footer></div>"`;
