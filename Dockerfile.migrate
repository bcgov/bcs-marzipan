FROM node:24-alpine

WORKDIR /app

# Needed for npm workspaces
COPY package.json package-lock.json ./
COPY tsconfig.base.json ./

# Copy workspace packages
COPY packages ./packages
COPY calendar-service ./calendar-service

# Install deps (including dev – this is OK for a Job)
ENV NODE_ENV=development
RUN apk add --no-cache postgresql-client
RUN npm ci

# Build database package
RUN npm run build --workspace=packages/database

# Default command = tracked incremental migrations only.
# Keep data-seeding separate so migrations are safe to re-run.
ENTRYPOINT ["npm", "run", "db:migrate", "--workspace=packages/database"]
