{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@corpcal/shared/(.*)$": "<rootDir>/../packages/shared/src/$1",
    "^@corpcal/shared$": "<rootDir>/../packages/shared/src",
    "^@corpcal/database/(.*)$": "<rootDir>/../packages/database/src/$1",
    "^@corpcal/database$": "<rootDir>/../packages/database/src"
  }
}
