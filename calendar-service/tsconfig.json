{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "baseUrl": "./",
    "rootDir": "./src",
    "incremental": true,
    "sourceMap": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@corpcal/shared": ["../packages/shared/dist/cjs"],
      "@corpcal/shared/*": ["../packages/shared/dist/cjs/*"],
      "@corpcal/database": ["../packages/database/dist/cjs"],
      "@corpcal/database/*": ["../packages/database/dist/cjs/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test", "scripts"]
}
