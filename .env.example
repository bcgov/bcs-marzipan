# Database Configuration
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Database Connection Pool Settings (optional)
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=20
DB_CONNECT_TIMEOUT=10

# API Configuration
# API authentication key (optional in development, required in production)
# If not set, all requests are allowed in development mode
API_KEY=your-api-key-here

# Service Port
# Backend service port (optional, defaults to 3001)
PORT=3001

# Frontend Configuration
# Frontend API base URL (optional, defaults to http://localhost:3001)
# Used by Vite during build and runtime
VITE_API_BASE_URL=http://localhost:3001

CANADA_POST_API_KEY=your-canada-post-api-key-here

# Authentication Configuration
# Auth strategy: 'mock' for development, 'ad' for Active Directory (future)
AUTH_STRATEGY=mock

# JWT Configuration
# Secret key for signing JWT tokens (required in production, defaults to dev secret)
# IMPORTANT: Use a strong, random secret in production (min 32 characters)
JWT_SECRET=your-jwt-secret-change-in-production

# JWT token expiration time in seconds (optional, defaults to 3600 = 1 hour)
JWT_EXPIRES_IN=3600
