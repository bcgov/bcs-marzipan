# K6 / CorpCal performance tests — copy to performance_tests/.env and adjust (optional).
# npm run perf:k6:local loads this file automatically when present.
# Shell environment variables always override values here.

# Required for ad-hoc runs without perf:k6:local (otherwise defaulted by that script):
# BASE_URL=http://127.0.0.1:3001

# Profile: smoke | standard
PERF_PROFILE=smoke

# Local defaults (matching perf:k6:local):
VUS=1
DURATION=10s

# Auth (see performance_tests/api/config.js)
PERF_USERNAME=thomas.garcia
# PERF_PASSWORD=

# Optional
# API_KEY=
# SKIP_LOOK_AHEAD=false
# PERF_CREATE_COMMS_USER_ID=18
# PERF_LEAD_TEAM_ID=2
# PERF_LEAD_MINISTRY_ID=1
# PERF_CREATE_CATEGORY_ID=1

# --- Browser smoke (performance_tests/browser/*.js) ---
# npm run perf:k6:browser:local defaults FRONTEND_URL and K6_BROWSER_HEADLESS if unset.
# FRONTEND_URL=http://127.0.0.1:3000
# K6_BROWSER_HEADLESS=true
#
# Unauthenticated browser flow (login surface + redirect):
#   npm run perf:k6:browser:flow:local
