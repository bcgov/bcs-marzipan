{
  "name": "corporate-calendar",
  "workspaces": [
    "calendar-ui",
    "calendar-service",
    "packages/database",
    "packages/shared"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "picomatch": "4.0.4",
    "ws": "8.20.1",
    "esbuild": ">=0.25.0",
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    },
    "lodash": ">=4.17.22",
    "tmp": ">=0.2.4"
  },
  "scripts": {
    "start": "concurrently \"npm --prefix calendar-ui run dev\" \"npm --prefix calendar-service run start:dev\"",
    "start:prod": "concurrently \"npm --prefix calendar-ui run preview\" \"npm --prefix calendar-service run start:prod\"",
    "install-all": "npm install --workspaces",
    "build": "npm run build:packages && npm run build --workspace=calendar-service && npm run build --workspace=calendar-ui",
    "build:packages": "npm run build --workspace=packages/database && npm run build --workspace=packages/shared",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:packages": "npm run typecheck --workspace=packages/database && npm run typecheck --workspace=packages/shared",
    "test": "concurrently -n \"service,ui,shared,database\" -c \"blue,green,yellow,magenta\" \"npm run test --workspace=calendar-service\" \"npm run test --workspace=calendar-ui\" \"npm run test --workspace=packages/shared\" \"npm run test --workspace=packages/database\"",
    "test:cov": "concurrently -n \"service,ui,shared,database\" -c \"blue,green,yellow,magenta\" \"npm run test:cov --workspace=calendar-service\" \"npm run test:cov --workspace=calendar-ui\" \"npm run test:cov --workspace=packages/shared\" \"npm run test:cov --workspace=packages/database\"",
    "test:env": "ts-node -r tsconfig-paths/register scripts/test-env-vars.ts",
    "test:config": "ts-node -r tsconfig-paths/register scripts/test-nestjs-config.ts",
    "prepare": "husky",
    "format": "prettier --write \"calendar-service/**/*.{ts,json}\" \"calendar-ui/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"calendar-service/**/*.{ts,json}\" \"calendar-ui/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,json}\" \"*.{json,md}\"",
    "lint": "eslint \"calendar-service/**/*.ts\" \"calendar-ui/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"calendar-service/**/*.ts\" \"calendar-ui/**/*.{ts,tsx}\" --fix",
    "check": "npm run lint && npm run typecheck",
    "check:fix": "npm run lint:fix && npm run typecheck",
    "perf:k6": "k6 run performance_tests/tests/corpcal-api.js",
    "perf:k6:smoke": "k6 run performance_tests/tests/corpcal-api-smoke.js -e PERF_PROFILE=smoke",
    "perf:k6:api-smoke": "k6 run performance_tests/tests/corpcal-api-smoke.js",
    "perf:k6:inspect": "node scripts/k6-inspect-all.cjs",
    "perf:k6:local": "node scripts/k6-local.cjs",
    "perf:k6:browser:local": "node scripts/k6-browser-local.cjs",
    "perf:k6:browser:flow:local": "node scripts/k6-browser-flow-local.cjs",
    "perf:k6:browser:auth:local": "node scripts/k6-browser-auth-local.cjs",
    "lint:service": "eslint \"calendar-service/**/*.ts\" --fix",
    "lint:ui": "eslint \"calendar-ui/**/*.{ts,tsx}\" --fix",
    "lint:staged": "lint-staged",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.18.0",
    "@eslint/json": "^0.14.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@swc/core": "^1.15.11",
    "@vitest/coverage-v8": "^4.0.18",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.0",
    "dotenv": "^16.6.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "calendar-service/**/*.ts": [
      "eslint --fix",
      "node scripts/test/vitest-related.js calendar-service"
    ],
    "calendar-ui/**/*.{ts,tsx}": [
      "eslint --fix",
      "node scripts/test/vitest-related.js calendar-ui"
    ],
    "packages/database/**/*.ts": [
      "eslint --fix",
      "node scripts/test/vitest-related.js database"
    ],
    "packages/shared/**/*.ts": [
      "eslint --fix",
      "node scripts/test/vitest-related.js shared"
    ],
    "**/*.{json,md,css,scss,less,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-radio-group": "^1.3.8",
    "openid-client": "^6.8.2"
  }
}
